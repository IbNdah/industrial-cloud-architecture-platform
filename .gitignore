### `.editorconfig`

<CodeBlock language="ini" editable>
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.py]
indent_style = space
indent_size = 4

[*.{yml,yaml,json,tf,md}]
indent_style = space
indent_size = 2

[*.ps1]
indent_style = space
indent_size = 4
